{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "actorSpecification": 1,
    "title": "Dataset Schema",
    "fields": {
        "type": "object",
        "properties": {
            "idCompra": { "title": "ID Compra", "type": "string" },
            "estadoCompra": { "title": "Estado Compra", "type": "string", "description": "1, 2 or 3" },
            "estadoCompraLabel": { "title": "Estado", "type": "string" },
            "reparticion": { "title": "Reparticion", "type": "string" },
            "tipoCompra": { "title": "Tipo de Compra", "type": "string" },
            "rubro": { "title": "Rubro", "type": "string" },
            "numeroExpediente": { "title": "Numero de Expediente", "type": "string" },
            "numeroConvocatoria": { "title": "Numero de Convocatoria", "type": ["string", "null"] },
            "primerRenglon": { "title": "Primer Renglon", "type": "string" },
            "valorPliego": { "title": "Valor del Pliego", "type": "string" },
            "presupuestoOficial": { "title": "Presupuesto Oficial", "type": ["string", "null"] },
            "garantiaOfertaExigida": { "title": "Garantia de Oferta Exigida", "type": ["string", "null"] },
            "fechaAperturaSobres": { "title": "Fecha de Apertura de Sobres", "type": ["string", "null"] },
            "fechaAdjudicacion": { "title": "Fecha de Adjudicacion", "type": ["string", "null"] },
            "lugarApertura": { "title": "Lugar de Apertura", "type": ["string", "null"] },
            "informesAdquisicionPliegos": { "title": "Informes / Adquisicion de Pliegos", "type": ["string", "null"] },
            "autorizadoPor": { "title": "Autorizado Por", "type": ["string", "null"] },
            "objetoLibre": { "title": "Objeto (texto libre)", "type": ["string", "null"] },
            "renglones": {
                "title": "Renglones",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "renglon": { "type": "string" },
                        "descripcion": { "type": "string" }
                    }
                }
            },
            "pliegoPdfUrl": { "title": "Pliego PDF URL", "type": ["string", "null"] },
            "record_id": {
                "title": "Record ID",
                "type": "string",
                "description": "Same value as idCompra, standardized across this portfolio's actors."
            },
            "event_type": {
                "title": "Event Type",
                "type": "string",
                "description": "NEW_LISTING (never seen before), STATUS_CHANGE (moved to a different estado_compra since last seen), UPDATED (amended within the same estado) or UNCHANGED (only ever delivered when Only new is off)."
            },
            "scraped_at": {
                "title": "Scraped At",
                "type": "string",
                "description": "ISO-8601 timestamp of this run's extraction, same for every record from one run."
            },
            "is_new": {
                "title": "Is New",
                "type": "boolean",
                "description": "True if this record's id was not already returned by a previous run at all, under any estado (computed even when onlyNew=false)."
            },
            "previousEstado": {
                "title": "Previous Estado",
                "type": ["string", "null"],
                "description": "Set only when event_type=STATUS_CHANGE: the estado_compra this id was last seen under."
            },
            "contentHash": {
                "title": "Content Hash",
                "type": "string",
                "description": "sha1 fingerprint of this record's changeable fields as of this run - used to detect UPDATED between runs."
            },
            "source_url": {
                "title": "Source URL",
                "type": "string",
                "description": "The listing page this record was read from, with a fragment identifying its own modal."
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "idCompra",
                    "tipoCompra",
                    "reparticion",
                    "rubro",
                    "numeroExpediente",
                    "fechaAperturaSobres",
                    "estadoCompraLabel",
                    "is_new",
                    "pliegoPdfUrl"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "ID", "format": "text", "field": "idCompra" },
                    { "label": "Tipo", "format": "text", "field": "tipoCompra" },
                    { "label": "Reparticion", "format": "text", "field": "reparticion" },
                    { "label": "Rubro", "format": "text", "field": "rubro" },
                    { "label": "Expediente", "format": "text", "field": "numeroExpediente" },
                    { "label": "Apertura", "format": "text", "field": "fechaAperturaSobres" },
                    { "label": "Estado", "format": "text", "field": "estadoCompraLabel" },
                    { "label": "Nuevo", "format": "text", "field": "is_new" },
                    { "label": "Pliego", "format": "link", "field": "pliegoPdfUrl" }
                ]
            }
        },
        "changes": {
            "title": "Status changes & amendments",
            "transformation": {
                "fields": [
                    "idCompra",
                    "event_type",
                    "previousEstado",
                    "estadoCompraLabel",
                    "reparticion",
                    "presupuestoOficial",
                    "fechaAperturaSobres",
                    "pliegoPdfUrl",
                    "scraped_at"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "ID", "format": "text", "field": "idCompra" },
                    { "label": "Evento", "format": "text", "field": "event_type" },
                    { "label": "Estado anterior", "format": "text", "field": "previousEstado" },
                    { "label": "Estado actual", "format": "text", "field": "estadoCompraLabel" },
                    { "label": "Reparticion", "format": "text", "field": "reparticion" },
                    { "label": "Presupuesto oficial", "format": "text", "field": "presupuestoOficial" },
                    { "label": "Apertura", "format": "text", "field": "fechaAperturaSobres" },
                    { "label": "Pliego", "format": "link", "field": "pliegoPdfUrl" },
                    { "label": "Detectado", "format": "date", "field": "scraped_at" }
                ]
            }
        }
    }
}
